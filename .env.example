# PPE Safety Monitor — Notification & Alerting Environment Variables
# Copy this file to .env and supply your local or organizational credentials.
# NEVER commit your actual passwords, private addresses, or SMTP tokens.

# SMTP Server Hostname (e.g., smtp.gmail.com, smtp.office365.com, or your internal mail relay)
SMTP_SERVER=smtp.example.com

# SMTP Server Port (587 for STARTTLS, 465 for SSL, or 25 for local non-auth relay)
SMTP_PORT=587

# SMTP Authentication Credentials
SMTP_USERNAME=alerts@yourdomain.com
SMTP_PASSWORD=your_secure_password_or_app_token

# Alert Routing
ALERT_SENDER_EMAIL=ppe-monitor@yourdomain.com
ALERT_RECIPIENT_EMAIL=safety_manager@yourdomain.com

# Notification Behavior
NOTIFY_ON_VIOLATION=true
NOTIFY_ON_INCIDENT=true
NOTIFY_ON_REVIEW=false
NOTIFICATION_COOLDOWN_SECONDS=60

